{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd anon-feed-ui && npm install && npm run build",
  "outputDirectory": "anon-feed-ui/dist",
  "devCommand": "cd anon-feed-ui && npm run dev",
  "installCommand": "npm install && cd anon-feed-ui && npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "VITE_NETWORK_ID": "preprod",
    "VITE_LOGGING_LEVEL": "info"
  }
}
